{
    "name": "Spontaneous Pooch Combustion",
    "description": "One of your pooches has burst into flames!",
    "flavor_text": "Quick, what will you do!?",
    "severity": "MAJOR",
    "rarity": "UNPRECEDENTED",
    "requires_response": true,
    "response_timeout": 3600,
    "filter": {
        "kennels": [
            {
                "min_count": 1,
                "min_pooches": 1
            }
        ]
    },
    "actions": [
        {
            "action_type": "select_pooch",
            "target_type": "pooch",
            "parameters": {
                "selector": "random",
                "filter": {
                    "location": "kennel"
                },
                "save_as": "burning_pooch",
                "featured": true,
                "save_kennel": true
            }
        }
    ],
    "options": [
        {
            "label": "Call the fire department",
            "description": "Medium chance to save your pooch but small chance of further damage.",
            "outcomes": [
                {
                    "chance": 0.4,
                    "message": "The firefighters save your pooch! It's a little burnt though.",
                    "actions": [
                        {
                            "action_type": "injure_pooch",
                            "target_type": "pooch",
                            "parameters": {
                                "use_saved": "burning_pooch",
                                "injury": "Singed"
                            }
                        }
                    ]
                },
                {
                    "chance": 0.5,
                    "message": "The firefighters don't get there in time. Your pooch dies horribly, but no more damage is done.",
                    "actions": [
                        {
                            "action_type": "kill_pooch",
                            "target_type": "pooch",
                            "parameters": {
                                "use_saved": "burning_pooch"
                            }
                        }
                    ]
                },
                {
                    "chance": 0.1,
                    "message": "No one shows up... Your kennel and your other pooches are damaged.",
                    "actions": [
                        {
                            "action_type": "kill_pooch",
                            "target_type": "pooch",
                            "parameters": {
                                "use_saved": "burning_pooch"
                            }
                        },
                        {
                            "action_type": "modify_money",
                            "target_type": "owner",
                            "parameters": {
                                "min_amount": -100,
                                "max_amount": -50
                            }
                        },
                        {
                            "action_type": "injure_pooch",
                            "target_type": "kennel",
                            "parameters": {
                                "use_saved": "burning_pooch",
                                "injury": "Singed"
                            }
                        }
                    ]
                }
            ]
        },
        {
            "label": "Save them yourself",
            "description": "Quickly try to put out the fire. Higher chance to save your pooch, but you might hurt yourself.",
            "outcomes": [
                {
                    "chance": 0.3,
                    "message": "You put out the fire before any damage is done."
                },
                {
                    "chance": 0.3,
                    "message": "You save your pooch, but both of you are a little burnt.",
                    "actions": [
                        {
                            "action_type": "modify_money",
                            "target_type": "owner",
                            "parameters": {
                                "min_amount": -25,
                                "max_amount": -5
                            }
                        },
                        {
                            "action_type": "injure_pooch",
                            "target_type": "pooch",
                            "parameters": {
                                "use_saved": "burning_pooch",
                                "injury": "Burn"
                            }
                        }
                    ]
                },
                {
                    "chance": 0.1,
                    "message": "You couldn't do it... They're dead.",
                    "actions": [
                        {
                            "action_type": "kill_pooch",
                            "target_type": "pooch",
                            "parameters": {
                                "use_saved": "burning_pooch"
                            }
                        }
                    ]
                },
                {
                    "chance": 0.3,
                    "message": "You couldn't do it... They're dead, and you hurt yourself in the process.",
                    "actions": [
                        {
                            "action_type": "modify_money",
                            "target_type": "owner",
                            "parameters": {
                                "min_amount": -50,
                                "max_amount": -10
                            }
                        },
                        {
                            "action_type": "kill_pooch",
                            "target_type": "pooch",
                            "parameters": {
                                "use_saved": "burning_pooch"
                            }
                        }
                    ]
                }
            ]
        },
        {
            "label": "Do nothing",
            "description": "Accept that they're going to die horribly.",
            "default": true,
            "visible": true,
            "outcomes": [
                {
                    "chance": 0.1,
                    "message": "The fire goes out on its own.",
                    "actions": [
                        {
                            "action_type": "injure_pooch",
                            "target_type": "pooch",
                            "parameters": {
                                "use_saved": "burning_pooch",
                                "injury": "Severe Burn"
                            }
                        }
                    ]
                },
                {
                    "chance": 0.5,
                    "message": "They die horribly, but no more damage is done.",
                    "actions": [
                        {
                            "action_type": "kill_pooch",
                            "target_type": "pooch",
                            "parameters": {
                                "use_saved": "burning_pooch"
                            }
                        }
                    ]
                },
                {
                    "chance": 0.2,
                    "message": "They die horribly, and the other pooches got burnt.",
                    "actions": [
                        {
                            "action_type": "kill_pooch",
                            "target_type": "pooch",
                            "parameters": {
                                "use_saved": "burning_pooch"
                            }
                        },
                        {
                            "action_type": "injure_pooch",
                            "target_type": "kennel",
                            "parameters": {
                                "use_saved": "burning_pooch",
                                "injury": "Singed"
                            }
                        }
                    ]
                },
                {
                    "chance": 0.2,
                    "message": "They die horribly, and you have to pay for damage to your kennel.",
                    "actions": [
                        {
                            "action_type": "kill_pooch",
                            "target_type": "pooch",
                            "parameters": {
                                "use_saved": "burning_pooch"
                            }
                        },
                        {
                            "action_type": "modify_money",
                            "target_type": "owner",
                            "parameters": {
                                "min_amount": -50,
                                "max_amount": -25
                            }
                        }
                    ]
                }
            ]
        }
    ]
}
