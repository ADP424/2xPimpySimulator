{
    "name": "Vet Bill",
    "description": "One of your pooches got sick and needs medical attention.",
    "flavor_text": "The vet says it's nothing serious, but it'll cost you.",
    "severity": "MINOR",
    "rarity": "UNCOMMON",
    "requires_response": true,
    "response_timeout": 7200,
    "filter": {
        "pooches": [
            {
                "min_count": 1,
                "is_alive": true
            }
        ]
    },
    "actions": [
        {
            "action_type": "modify_base_health",
            "target_type": "pooch",
            "parameters": {
                "selector": "random",
                "min_amount": -5,
                "max_amount": -1,
                "filter": {
                    "is_alive": true
                },
                "save_as": "sick_pooch"
            }
        }
    ],
    "options": [
        {
            "label": "Pay for treatment",
            "description": "Pay $50 to treat your pooch.",
            "filter": {
                "min_money": 50
            },
            "actions": [
                {
                    "action_type": "modify_base_health",
                    "target_type": "pooch",
                    "parameters": {
                        "use_saved": "sick_pooch",
                        "min_amount": 1,
                        "max_amount": 5
                    }
                },
                {
                    "action_type": "modify_money",
                    "target_type": "owner",
                    "parameters": {
                        "amount": -50
                    }
                }
            ]
        },
        {
            "label": "Let nature take its course",
            "description": "Give them a warm blanket and hope they recover on their own...",
            "outcomes": [
                {
                    "chance": 0.8,
                    "message": "The sickness has done its damage."
                },
                {
                    "chance": 0.2,
                    "message": "Your pooch recovered some health with its resting.",
                    "actions": [
                        {
                            "action_type": "modify_base_health",
                            "target_type": "pooch",
                            "parameters": {
                                "use_saved": "sick_pooch",
                                "min_amount": 1,
                                "max_amount": 5
                            }
                        }
                    ]
                }
            ]
        },
        {
            "label": "Ignore the bill",
            "description": "You neglected your pooch, and it suffered the consequences.",
            "default": true,
            "visible": false
        }
    ]
}
