{
    "name": "Escaped Pooch",
    "description": "One of your pooches has escaped from the kennel!",
    "flavor_text": "Quick, what do you do!?",
    "severity": "MAJOR",
    "rarity": "UNCOMMON",
    "requires_response": true,
    "response_timeout": 3600,
    "filter": {
        "kennels": [
            {
                "min_count": 1,
                "min_pooches": 1
            }
        ]
    },
    "actions": [
        {
            "action_type": "kill_pooch",
            "target_type": "pooch",
            "parameters": {
                "selector": "random",
                "filter": {
                    "location": "kennel"
                }
            }
        }
    ],
    "options": [
        {
            "label": "Hire a search party",
            "description": "Pay $100 to hire professionals to find your pooch.",
            "filter": {
                "min_money": 100
            },
            "actions": [
                {
                    "action_type": "modify_money",
                    "target_type": "owner",
                    "parameters": {
                        "amount": -100
                    }
                }
            ],
            "outcomes": [
                {
                    "chance": 0.9,
                    "message": "The professionals found your pooch. Phew!"
                },
                {
                    "chance": 0.1,
                    "message": "Even the professionals couldn't find them, though you manage to haggle for a partial refund...",
                    "actions": [
                        {
                            "action_type": "kill_pooch", // TODO: Turn into a stray instead
                            "target_type": "pooch",
                            "parameters": {
                                "selector": "random",
                                "filter": {
                                    "location": "kennel"
                                }
                            }
                        },
                        {
                            "action_type": "modify_money",
                            "target_type": "owner",
                            "parameters": {
                                "min_amount": 25,
                                "max_amount": 50
                            }
                        }
                    ]
                }
            ]
        },
        {
            "label": "Search yourself",
            "description": "Spend time searching. There's a strong chance you won't find them...",
            "outcomes": [
                {
                    "chance": 0.4,
                    "message": "You found your lost pooch!"
                },
                {
                    "chance": 0.6,
                    "message": "You couldn't find your pooch anywhere...",
                    "actions": [
                        {
                            "action_type": "kill_pooch",
                            "target_type": "pooch",
                            "parameters": {
                                "selector": "random",
                                "filter": {
                                    "location": "kennel"
                                }
                            }
                        }
                    ]
                }
            ]
        },
        {
            "label": "Give up",
            "description": "Accept that they're gone...",
            "default": true,
            "visible": true,
            "actions": [
                {
                    "action_type": "kill_pooch",
                    "target_type": "pooch",
                    "parameters": {
                        "selector": "random",
                        "filter": {
                            "location": "kennel"
                        }
                    }
                }
            ]
        }
    ]
}
