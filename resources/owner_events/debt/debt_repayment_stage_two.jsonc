{
    "name": "Debt Repayment Again",
    "description": "The bank has come for it's money.",
    "flavor_text": "They will keep taking pooches or kennels until your debt improves.",
    "severity": "MAJOR",
    "rarity": "COMMON",
    "requires_response": false,
    "filter": {
        "max_money": -1,
        "pooches": [
            {
                "max_count": 0,
                "is_alive": true
            }
        ],
        "kennels": [
            {
                "min_count": 2
            }
        ]
    },
    "actions": [
        {
            "action_type": "delete_kennel",
            "target_type": "owner"
        },
        {
            "action_type": "modify_money",
            "target_type": "owner",
            "parameters": {
                "min_amount": 100,
                "max_amount": 500
            }
        }
    ]
}
