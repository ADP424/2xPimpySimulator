{
    "name": "Debt Repayment",
    "description": "The bank has come for its money.",
    "flavor_text": "They will keep taking pooches until your debt improves.",
    "severity": "MODERATE",
    "rarity": "COMMON",
    "requires_response": false,
    "filter": {
        "max_money": -1,
        "pooches": [
            {
                "min_count": 1,
                "is_alive": true
            }
        ]
    },
    "actions": [
        {
            "action_type": "modify_money", // TODO: Should force sell a random pooch you own.
            "target_type": "owner",
            "parameters": {
                "min_amount": 100,
                "max_amount": 500
            }
        }
    ]
}
