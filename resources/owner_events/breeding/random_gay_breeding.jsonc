{
    "name": "Random Gay Breeding",
    "description": "Two of your pooches bred without permission.",
    "flavor_text": "You're not sure how they managed to get pregnent.",
    "severity": "MODERATE",
    "rarity": "UNPRECEDENTED",
    "requires_response": false,
    "filter": {
        "kennels": [
            {
                "pooches": [
                    {
                        "min_count": 2,
                        "sex": "female",
                        "is_alive": true,
                        "max_breeding_cooldown": 0
                    }
                ]
            }
        ]
    },
    "actions": [
        {
            "action_type": "breed_pooches",
            "target_type": "owner",
            "parameters": {
                "first_selector": "random", // TODO: Not sure if this would target the same pooch twice.
                "first_filter": {
                    "sex": "female",
                    "is_alive": true,
                    "max_breeding_cooldown": 0
                },
                "second_selector": "random",
                "second_filter": {
                    "sex": "female",
                    "is_alive": true,
                    "max_breeding_cooldown": 0
                }
            }
        }
    ]
}
