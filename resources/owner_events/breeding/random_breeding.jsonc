{
    "name": "Random Breeding",
    "description": "Two of your pooches bred without permission.",
    "flavor_text": "Maybe you should throw them in cages.",
    "severity": "MODERATE",
    "rarity": "NOVEL",
    "requires_response": false,
    "filter": {
        "pooches": [ // TODO: Make in kennel
            { 
                "sex": "male",
                "is_alive": true,
                "max_breeding_cooldown": 0
            },
            { 
                "sex": "female",
                "is_alive": true,
                "max_breeding_cooldown": 0
            }
        ]
    },
    "actions": [
        {
            "action_type": "breed_pooches",
            "target_type": "owner",
            "parameters": {
                "first_selector": "random",
                "first_filter": {
                    "sex": "male",
                    "is_alive": true,
                    "max_breeding_cooldown": 0
                },
                "second_selector": "random",
                "second_filter": {
                    "sex": "female",
                    "is_alive": true,
                    "max_breeding_cooldown": 0
                }
            }
        }
    ]
}
