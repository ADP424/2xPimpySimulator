{
    "name": "Become Infertile",
    "description": "One of your pooches just became infertile.",
    "flavor_text": "God must hate them.",
    "severity": "MODERATE",
    "rarity": "NOVEL",
    "requires_response": false,
    "filter": {
        "pooches": [
            {
                "min_count": 1,
                "is_alive": true
            }
        ]
    },
    "actions": [
        {
            "action_type": "modify_breeding_cooldown",
            "target_type": "pooch",
            "parameters": {
                "amount": 999,
                "mode": "set",
                "selector": "random",
                "save_as": "infertile_pooch",
                "filter": {
                    "is_alive": true
                }
            }
        },
        {
            "action_type": "modify_fertility",
            "target_type": "pooch",
            "parameters": {
                "amount": 999,
                "mode": "set",
                "use_saved": "infertile_pooch"
            }
        }
    ]
}
