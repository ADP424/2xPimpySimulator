{
    "name": "Stray Dog Appears",
    "description": "A stray dog apears at one of your kennels.",
    "flavor_text": "Do be careful though, strays might come with diseases or other problems.",
    "severity": "MINOR",
    "rarity": "COMMON",
    "requires_response": true,
    "response_timeout": 7200,
    "filter": {
        "pooches": [
            {
                "min_count": 1,
                "location": "town",
                "is_alive": true
            }
        ],
        "kennels": [
            {
                "min_count": 1,
                "max_pooches": -1
            }
        ]
    },
    "actions": [
        {
            "action_type": "select_pooch",
            "target_type": "pooch",
            "parameters": {
                "selector": "random",
                "filter": {
                    "is_alive": true
                },
                "save_as": "stray_pooch",
                "featured": true
            }
        }
    ],
    "options": [
        {
            "label": "Let them in.",
            "description": "The pooch will join one of your kennels.",
            "actions": [
                {
                    "action_type": "receive_stray",
                    "target_type": "pooch",
                    "parameters": {
                        "use_saved": "stray_pooch"
                    }
                }
            ]
        },
        {
            "label": "Ignore them",
            "description": "You don't want to take the risks.",
            "default": true,
            "visible": true,
            "outcomes": [
                {
                    "chance": 0.1,
                    "message": "As you close the door you hear the stray yelp. When you open the door again there is nothing left of it but ash.",
                    "actions": [
                        {
                            "action_type": "receive_stray",
                            "target_type": "owner",
                            "parameters": {
                                "destination": "hell",
                                "use_saved": "stray_pooch"
                            }
                        },
                        {
                            "action_type": "rename_pooch",
                            "target_type": "pooch",
                            "parameters": {
                                "use_saved": "stray_pooch",
                                "name": "Forsaken Soul"
                            }
                        }
                    ]
                },
                {
                    "chance": 0.9,
                    "message": "The stray leaves sadly."
                }
            ]
        }
    ]
}
