{
    "name": "Cheese or Fish",
    "description": "A strange man appears. He asks you, \"Cheese or Fish?\"",
    "flavor_text": "He doesn't seem to respond to anything but cheese or fish.",
    "severity": "MINOR",
    "rarity": "UNCOMMON",
    "requires_response": true,
    "response_timeout": 7200,
    "filter": {
        "pooches": [
            {
                "min_count": 1,
                "is_alive": true
            }
        ]
    },
    "options": [
        {
            "label": "Say cheese.",
            "description": "Cheese.",
            "filter": {
                "min_money": 10
            },
            "actions": [
                {
                    "action_type": "modify_money",
                    "target_type": "owner",
                    "parameters": {
                        "amount": -10
                    }
                }
            ]
        },
        {
            "label": "Say fish.",
            "description": "Fish.",
            "filter": {
                "min_bloodskulls": 1
            },
            "actions": [
                {
                    "action_type": "modify_bloodskulls",
                    "target_type": "owner",
                    "parameters": {
                        "amount": -1
                    }
                }
            ]
        },
        {
            "label": "Call the cops.",
            "description": "You don't like the look of him or his questions.",
            "actions": [
                {
                    "action_type": "injure_pooch",
                    "target_type": "pooch",
                    "parameters": {
                        "selector": "random",
                        "filter": {
                            "is_alive": true
                        },
                        "injury": "Minor"
                    }
                }
            ]
        },
        {
            "label": "Ignore the man.",
            "description": "He grins and leaves you his blessing.",
            "default": true,
            "visible": false,
            "actions": [
                {
                    "action_type": "modify_base_health",
                    "target_type": "pooch",
                    "parameters": {
                        "amount": 1,
                        "selector": "random",
                        "filter": {
                            "is_alive": true
                        }
                    }
                },
                {
                    "action_type": "modify_bloodskulls",
                    "target_type": "owner",
                    "parameters": {
                        "amount": 1
                    }
                },
                {
                    "action_type": "modify_money",
                    "target_type": "owner",
                    "parameters": {
                        "amount": 10
                    }
                }
            ]
        }
    ]
}
