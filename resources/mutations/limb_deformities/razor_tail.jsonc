{
    "name": "Razor Tail",
    "description": "This pooch has an unusually sharp, blade-like tail. It can be a hazard to other pooches if this one dies nearby.",
    "heritability": 0.15,
    "health_impact": "NEUTRAL",
    "rarity": "UNCOMMON",
    "parameters": {
        "on_death_triggers": [
            {
                "on_death": "injure",
                "on_death_targets": "random",
                "on_death_chance": 0.75,
                "on_death_options": ["Minor Scratch"],
                "impact_message": "{victim.name} was caught by {pooch.name}'s razor-sharp tail as they fell."
            }
        ]
    }
}
