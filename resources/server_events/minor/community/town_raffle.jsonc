{
  "name": "Town Raffle",
  "description": "The whole server is invited to throw a few dollars into the town raffle.",
  "flavor_text": "The ticket drum is already clattering.",
  "severity": "minor",
  "rarity": "common",
  "filter": {
    "min_owners": 1
  },
  "menus": {
    "enter": {
      "label": "Enter the Raffle",
