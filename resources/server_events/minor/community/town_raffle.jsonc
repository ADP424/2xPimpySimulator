        {
          "label": "Buy a raffle ticket",
          "description": "Pay $5 for a shot at the prize.",
          "filter": {
            "min_money": 5
          },
          "actions": [
            {
              "action_type": "modify_money",
              "target_type": "owner",
              "parameters": {
                "amount": -5
              }
            }
          ],
          "scoring": {
            "aggregate": "sum",
            "sources": [
              { "type": "random", "min": 0.0, "max": 1.0 }
            ]
          }
        }
      ]
    }
  },
  "outcomes": [
    {
      "label": "Winner",
      "message": "You won the town raffle!",
      "target": "ranked_players",
      "min_rank": 1,
      "max_rank": 1,
      "actions": [
        {
          "action_type": "modify_money",
          "target_type": "owner",
          "parameters": {
            "amount": 100
          }
        }
      ]
    }
  ]
